// youtube/verify_video — confirm ONE video really exists on the channel with the expected
// privacy, via the Data API. Token-only + api-only → runs with NO browser.
//
// Deliberately INDEPENDENT of what the publishing recipe reported. riverside/share_youtube
// returning "ok" while this finds no such video is exactly the disagreement worth catching, and
// it is why a pipeline step is not complete until its verify passes.
//
// Absence of evidence is FAILURE, never success: YouTube answers 200 with an empty `items` for an
// unknown id, so expect-status proves nothing. The assertions below are the real check.
//
// NOTE: one `capture` per `api` step, because ApiRequest holds a single capture_key (a later
// capture silently overwrites an earlier one). Hence the repeated GETs; each is 1 quota unit.
recipe "youtube/verify_video" {
    description "Confirm a YouTube video exists with the expected privacy (Data API, no browser)."
    limit-key "youtube.read"

    var "token" required=#true doc="OAuth access token (pacewright injects it from the secret store)"
    var "video_id" required=#true doc="the id the publishing step produced"
    var "expect_privacy" default="unlisted" doc="unlisted | public | private"

    step {
        api "GET" url="https://www.googleapis.com/youtube/v3/videos?part=snippet,status&id={{ video_id }}" \
            bearer="{{ token }}" expect-status=200 {
            capture "found" path="pageInfo.totalResults"
        }
    }

    step {
        api "GET" url="https://www.googleapis.com/youtube/v3/videos?part=snippet,status&id={{ video_id }}" \
            bearer="{{ token }}" expect-status=200 {
            capture "privacy" path="items.0.status.privacyStatus"
        }
    }

    step {
        api "GET" url="https://www.googleapis.com/youtube/v3/videos?part=snippet,status&id={{ video_id }}" \
            bearer="{{ token }}" expect-status=200 {
            capture "title" path="items.0.snippet.title"
        }
    }

    // The video must exist at all: this is the assertion that catches "the recipe said ok but
    // nothing was published".
    step {
        expect on-fail="terminal" message="no video {{ video_id }} on the channel: nothing was published" {
            value "{{ found }}" not-equals="0"
        }
    }
    step {
        expect on-fail="terminal" message="video {{ video_id }} privacy is {{ privacy }}, expected {{ expect_privacy }}" {
            value "{{ privacy }}" equals="{{ expect_privacy }}"
        }
    }
    step {
        expect on-fail="terminal" message="video {{ video_id }} has an empty title" {
            value "{{ title }}" non-empty=#true
        }
    }
}
