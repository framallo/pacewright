// podcast/episode — Riverside project to a published episode with VERIFIED URLs.
//
// Install to ~/.pacewright/recipes/pipelines/podcast-episode.kdl, then:
//   pacewright run podcast/episode --run-id ep172 --params '{
//     "project_id":"6a4d71a7…","episode_number":"172","title":"Jane Doe on X"}'
//   pacewright show ep172
//
// Resume is the same command: succeeded steps are skipped, so a mid-pipeline failure
// costs only the failed step. Re-queue failures with --retry-failed.
//
// STATUS: the action recipes below all exist. The `verify` recipes (youtube/verify_video,
// youtube/verify_shorts, spotify/verify_episode, riverside/verify_exports) are PHASE 2 and
// are not installed yet, so this pipeline will fail at its first verify until they land.
// That failure mode is deliberate: an unverifiable step must not silently pass, which is
// exactly what riverside/publish_clips did when it published zero shorts and reported ok.
pipeline "podcast/episode" {
    description "Riverside project -> YouTube long + shorts + Spotify, each independently confirmed"
    pace min="90s" max="5m"

    var "project_id"     required=#true
    var "episode_number" required=#true
    var "title"          required=#true
    var "description"    default=""
    var "publish_date"   default=""

    // 1. Render the magic clips. Verified by asking Riverside for the export tiles
    //    rather than trusting that the render step returned.
    step "render_clips" recipe="riverside/render_clips" {
        params {
            project_id "{{ vars.project_id }}"
        }
        attempts 3
        verify recipe="riverside/verify_exports" {
            params {
                project_id "{{ vars.project_id }}"
                min_clips "1"
            }
        }
    }

    // 2. The long episode to YouTube as Unlisted.
    step "publish_long" recipe="riverside/share_youtube" after="render_clips" {
        params {
            project_id "{{ vars.project_id }}"
            title "EP{{ vars.episode_number }} {{ vars.title }}"
            do_publish "true"
        }
        attempts 2
        verify recipe="youtube/verify_video" {
            params {
                video_id "{{ steps.publish_long.result.publish.video_id }}"
                expect_privacy "unlisted"
                expect_title "EP{{ vars.episode_number }} {{ vars.title }}"
            }
        }
        fallback recipe="claude/adjudicate" {
            params {
                question "Is the EP{{ vars.episode_number }} long video on the PreVetted channel as Unlisted? Answer ok:false unless you can cite the API response or the video id."
                context "{{ steps.publish_long.result }}"
            }
        }
    }

    // 3. Shorts to YouTube as Unlisted. This is the step that once reported success
    //    while publishing ZERO shorts, hence the count check in its verify.
    step "publish_shorts" recipe="riverside/publish_clips" after="publish_long" {
        params {
            project_id "{{ vars.project_id }}"
        }
        attempts 3
        verify recipe="youtube/verify_shorts" {
            params {
                expect_privacy "unlisted"
                min_count "1"
            }
        }
    }

    // 4. The episode to Spotify. Least-proven step, so its verify is the strictest.
    step "share_spotify" recipe="riverside/share_spotify" after="publish_long" {
        params {
            project_id "{{ vars.project_id }}"
            title "EP{{ vars.episode_number }} {{ vars.title }}"
            description "{{ vars.description }}"
            publish_date "{{ vars.publish_date }}"
        }
        attempts 2
        verify recipe="spotify/verify_episode" {
            params {
                expect_title "EP{{ vars.episode_number }} {{ vars.title }}"
                require_description "true"
                require_art "true"
            }
        }
        fallback recipe="claude/adjudicate" {
            params {
                question "Did the EP{{ vars.episode_number }} Spotify episode really get created with a non-empty description and art? A blank draft is NOT success. Answer ok:false unless you can cite what you saw."
                context "{{ steps.share_spotify.result }}"
            }
        }
    }

    output {
        youtube_url "{{ steps.publish_long.verify.result.url }}"
        shorts_urls "{{ steps.publish_shorts.verify.result.urls }}"
        spotify_url "{{ steps.share_spotify.verify.result.url }}"
    }
}
